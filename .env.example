# Copy this file to .env.local (git-ignored) and fill in only what you need.
# Every variable is optional. Anything left empty falls back to a clearly labelled demo mode.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API Keys. Use the publishable key (sb_publishable_…) only.
# NEVER put a secret / service_role key here: these values are shipped to the browser.
# (The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Google Gemini (server only; never prefix with NEXT_PUBLIC_) ─────────────
# https://aistudio.google.com/apikey
# Up to three keys. Extra keys are used only for failover during temporary outages
# (5xx, timeouts). On a quota error (429) the app pauses Gemini and uses the
# rule-based parser instead; keys are never rotated to get around a quota.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Google Maps Platform ────────────────────────────────────────────────────
# Server key: Places API (New) and Routes API (driving times).
# Places is used only when Supabase is NOT configured.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API. Restrict it by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID for cloud-based map styling.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ─── Routing ─────────────────────────────────────────────────────────────────
# OSRM server used when the Routes API is not configured.
# Defaults to the public demo server (https://router.project-osrm.org), which is
# not meant for production traffic.
OSRM_URL=
