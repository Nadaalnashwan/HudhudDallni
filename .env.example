# Copy to .env.local (git-ignored). Every key is optional — missing ones fall back to a labelled demo mode.

# Supabase "Hudhud AI" project → Project Settings → API Keys.
# Publishable key only (sb_publishable_…). NEVER put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Groq — understanding Saudi-dialect requests, plan edits and review drafting
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Google services. Places is only used when Supabase is NOT configured.
GOOGLE_MAPS_API_KEY=                  # server: Places API (New) + Routes API (driving times)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=  # browser: Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAP_ID=
