# Copy to .env.local. Every key is optional — without it the app runs in Demo Mode.

# Server-side key: Places API (New) + Routes API. Never exposed to the browser.
GOOGLE_MAPS_API_KEY=

# Browser key: Maps JavaScript API (restrict it to your domain / localhost in Google Cloud).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Optional vector Map ID (needed for Advanced Markers in production)
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Groq — understanding Saudi-dialect requests, plan edits and review drafting
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase — preferences, plans, visits and our own published reviews
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
